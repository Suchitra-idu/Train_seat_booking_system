# Copy to .env — working local defaults, no secrets to fill in:  cp .env.example .env
# Everything the system needs is config (PLAN D11); nothing is hardcoded in a rule.

# ─── Postgres ────────────────────────────────────────────────────────────
POSTGRES_USER=slr
POSTGRES_PASSWORD=slr_local_dev
POSTGRES_DB=slr
POSTGRES_HOST=db
POSTGRES_PORT=5432
# App connection string (async driver wired in P3). Host `db` = the compose service.
DATABASE_URL=postgresql+psycopg://slr:slr_local_dev@db:5432/slr

# ─── Services ────────────────────────────────────────────────────────────
API_PORT=8000
WEB_PORT=5173
# Browser → API base URL (used by the web app in P6).
VITE_API_BASE_URL=http://localhost:8000

# ─── Booking policy (config-driven — D11; consumed from P3 onward) ────────
HOLD_TTL_SECONDS=120
PENDING_TTL_SECONDS=3600
SEAT_CAP_PER_PASSENGER=6
VELOCITY_WINDOW_SECONDS=600
BOOKING_VELOCITY_LIMIT=10
ABUSE_THRESHOLD=0.8
STANDING_CAPACITY=250
CURRENCY=LKR
FARE_STRATEGY=dynamic
# Per-km base fare in cents (LKR). ~Rs 6.85/km ≈ Colombo–Badulla 2nd class over 292 km.
FARE_RATE_PER_KM_CENTS=685
# Fare class multipliers (D4).
CLASS_MULT_FIRST=2.0
CLASS_MULT_SECOND=1.0
CLASS_MULT_THIRD=0.7

# ─── Admin counter app (D21) ─────────────────────────────────────────────
# Shared counter key guarding the admin settle/lookup routes (staff login in production).
COUNTER_KEY=counter-dev-key
