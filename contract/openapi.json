  "info": {
    "summary": "Segment-based train seat booking (Colombo Fort to Badulla).",
    "title": "SLR Booking API",
    "version": "0.7.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/": {
      "get": {
        "operationId": "health__get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "title": "Response Health  Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Health",
        "tags": [
          "health"
        ]
      }
    },
    "/admin/unreserved/sell": {
      "post": {
        "operationId": "sell_admin_unreserved_sell_post",
        "parameters": [
          {
            "in": "header",
            "name": "x-counter-key",
            "required": false,
            "schema": {
              "default": "",
              "title": "X-Counter-Key",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SellUnreservedRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReceiptOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Sell",
        "tags": [
          "admin"
        ]
      }
    },
