            "title": "Dest Seq",
            "type": "integer"
          },
          "fare": {
            "$ref": "#/components/schemas/MoneyOut"
          },
          "held_until": {
            "title": "Held Until",
            "type": "integer"
          },
          "origin_seq": {
            "title": "Origin Seq",
            "type": "integer"
          },
          "passenger_id": {
            "title": "Passenger Id",
            "type": "string"
          },
          "passenger_name": {
            "title": "Passenger Name",
            "type": "string"
          },
          "reference": {
            "title": "Reference",
            "type": "string"
          },
          "seat_id": {
            "title": "Seat Id",
            "type": "string"
