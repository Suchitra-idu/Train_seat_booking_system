{
  "name": "slr-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --host --port 5173",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src",
    "arch": "depcruise src --config .dependency-cruiser.cjs",
    "check": "npm run lint && npm run arch && npm run test"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.0",
    "@sveltejs/vite-plugin-svelte": "^4.0.0",
    "dependency-cruiser": "^16.4.0",
    "eslint": "^9.9.0",
    "eslint-plugin-svelte": "^2.43.0",
    "globals": "^15.15.0",
    "jsdom": "^25.0.0",
    "svelte": "^5.0.0",
    "vite": "^5.4.0",
    "vitest": "^2.0.0"
  }
}
